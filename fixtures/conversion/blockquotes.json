[
  {
    "id": "blockquote_simple",
    "description": "Simple blockquote",
    "input": {
      "html": "<blockquote><p>Quote text</p></blockquote>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "> Quote text"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_simple",
      "title": "Simple blockquote"
    }
  },
  {
    "id": "blockquote_nested",
    "description": "Nested blockquote produces double-prefixed lines",
    "input": {
      "html": "<blockquote><p>Outer quote.</p><blockquote><p>Inner quote.</p></blockquote></blockquote>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Outer quote.",
          "Inner quote."
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_nested",
      "title": "Nested blockquote produces double-prefixed lines"
    }
  },
  {
    "id": "blockquote_multiple_paragraphs",
    "description": "Blockquote with multiple paragraphs has each paragraph prefixed",
    "input": {
      "html": "<blockquote><p>First paragraph.</p><p>Second paragraph.</p></blockquote>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "> First paragraph.",
          "> Second paragraph."
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_multiple_paragraphs",
      "title": "Blockquote with multiple paragraphs has each paragraph prefixed"
    }
  },
  {
    "id": "blockquote_with_list",
    "description": "Blockquote containing a list preserves list items inside quote",
    "input": {
      "html": "<blockquote><p>Quote intro:</p><ul><li>Point one</li><li>Point two</li></ul></blockquote>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Quote intro:",
          "Point one",
          "Point two"
        ]
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_with_list",
      "title": "Blockquote containing a list preserves list items inside quote"
    }
  },
  {
    "id": "blockquote_nested_list_indentation_preserved",
    "description": "Nested list inside a blockquote keeps its continuation indentation",
    "input": {
      "html": "<blockquote><ul><li>item a<ul><li>sub a1</li></ul></li></ul></blockquote>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "> - item a\n>   * sub a1\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_nested_list_indentation_preserved",
      "title": "Nested list inside a blockquote keeps its continuation indentation"
    }
  },
  {
    "id": "blockquote_code_block_indentation_preserved",
    "description": "Code block inside a blockquote keeps its line indentation",
    "input": {
      "html": "<blockquote><pre><code>line1\n    line2 indented</code></pre></blockquote>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "> ```\n> line1\n>     line2 indented\n> ```\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_code_block_indentation_preserved",
      "title": "Code block inside a blockquote keeps its line indentation"
    }
  },
  {
    "id": "blockquote_text_then_paragraph_gets_blank_line",
    "description": "Bare text followed by a paragraph inside a blockquote gets a blank-line separator instead of merging into one line",
    "input": {
      "html": "<blockquote>Just text, then <p>a paragraph</p></blockquote>"
    },
    "assertions": [
      {
        "type": "equals",
        "field": "content",
        "value": "> Just text, then\n>\n> a paragraph\n"
      }
    ],
    "docs": {
      "topic": "conversion",
      "stem": "blockquote_text_then_paragraph_gets_blank_line",
      "title": "Bare text followed by a paragraph inside a blockquote gets a blank-line separator instead of merging into one line"
    }
  }
]

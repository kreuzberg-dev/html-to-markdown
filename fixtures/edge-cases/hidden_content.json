[
  {
    "id": "hidden_content_template_element_dropped",
    "description": "Content inside <template> is never rendered per the HTML spec and must not appear in the output",
    "input": {
      "html": "<p>visible</p><template><p>secret template text</p></template><p>also visible</p>"
    },
    "assertions": [
      {
        "type": "not_contains",
        "field": "content",
        "value": "secret template text"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "visible",
          "also visible"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "hidden_content_template_element_dropped",
      "title": "Content inside <template> is never rendered and is dropped"
    }
  },

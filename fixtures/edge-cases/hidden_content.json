  {
    "id": "hidden_content_aria_hidden_still_rendered",
    "description": "aria-hidden only hides content from assistive tech, not visually — it must still be rendered",
    "input": {
      "html": "<p>visible</p><div aria-hidden=\"true\">still shown</div><p>also visible</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "visible",
          "still shown",
          "also visible"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "hidden_content_aria_hidden_still_rendered",
      "title": "aria-hidden content is still visually rendered"
    }
  }

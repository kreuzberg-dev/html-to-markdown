[
  {
    "id": "malformed_unclosed_paragraph",
    "description": "Unclosed <p> tag is recovered gracefully and content is preserved",
    "input": {
      "html": "<p>This paragraph is never closed"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "This paragraph is never closed"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "malformed_unclosed_paragraph",
      "title": "Unclosed <p> tag is recovered gracefully and content is preserved"
    }
  },
  {
    "id": "malformed_overlapping_tags",
    "description": "Overlapping bold/italic tags are recovered by the HTML parser without panic",
    "input": {
      "html": "<p><b><i>bold and italic</b></i></p>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "bold and italic"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "malformed_overlapping_tags",
      "title": "Overlapping bold/italic tags are recovered by the HTML parser without panic"
    }
  },
  {
    "id": "malformed_missing_block_closing_tags",
    "description": "Missing closing tags on block elements are auto-closed by parser",
    "input": {
      "html": "<div><h1>Title<p>First paragraph<p>Second paragraph</div>"
    },
    "assertions": [
      {
        "type": "not_empty",
        "field": "content"
      },
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "Title",
          "First paragraph",
          "Second paragraph"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "malformed_missing_block_closing_tags",
      "title": "Missing closing tags on block elements are auto-closed by parser"
    }
  },
  {
    "id": "malformed_bogus_comment_triple_dash",
    "description": "HTML comment ending with ---> (three dashes) must not drop content that follows (issue #339)",
    "input": {
      "html": "<h1>One</h1>\n<!-- /// --->\n<p>Two</p>"
    },
    "assertions": [
      {
        "type": "contains_all",
        "field": "content",
        "values": [
          "One",
          "Two"
        ]
      }
    ],
    "docs": {
      "topic": "edge-cases",
      "stem": "malformed_bogus_comment_triple_dash",
      "title": "HTML comment ending with ---> (three dashes) must not drop content that follows (issue #339)"
    }
  },
